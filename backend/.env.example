# ==============================================================================
# Namma Karnataka - Backend Environment Configuration Template
# NOTE: This file contains placeholders only. Never put real credentials here.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Supabase PostgreSQL & Auth (Server-side ONLY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder_supabase_service_role_key
SUPABASE_JWT_SECRET=placeholder_supabase_jwt_secret

# AI Providers (Server-side ONLY)
GROQ_API_KEY=placeholder_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=placeholder_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# AI Orchestration Policy
AI_EXECUTION_MODE=primary_then_fallback
AI_PRIMARY_TIMEOUT_SECONDS=12
AI_SECONDARY_TIMEOUT_SECONDS=15
AI_GLOBAL_TIMEOUT_SECONDS=28
AI_ENABLE_LIVE_PROVIDERS=false

# Optional Integrations
SARVAM_API_KEY=placeholder_sarvam_api_key
ENABLE_SARVAM_REPAIR=false
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
