# ==============================================================================
# Namma Karnataka - Frontend Environment Configuration Template
# NOTE: Variables prefixed with VITE_ are PUBLICLY VISIBLE in client bundles.
# NEVER place secret API keys or service role tokens in this file!
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Client Configuration (Public/Anonymous ONLY)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder_public_anon_key

# Default Locale (en or kn)
VITE_DEFAULT_LANGUAGE=en
